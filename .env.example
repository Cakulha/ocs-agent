# 复制本文件为 .env 并填入真实配置
# cp .env.example .env

# API Key
LLM_API_KEY=your-api-key

# LLM 服务地址（OpenAI 兼容协议）
LLM_ENDPOINT=https://your-llm-host/v1/chat/completions

# 模型名称
LLM_MODEL=your-model-name

# HTTP 超时（秒）
LLM_TIMEOUT_SECONDS=60

# 单次请求最大生成 token 数（思考模式需要更大预算，如 4096）
LLM_MAX_TOKENS=1024

# 是否启用 thinking 模式
LLM_THINKING=false

# 服务端口
SERVER_PORT=3000
